# INZOVATE AI HRMS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and provide your production credentials

# Relational Database URL (SQLite for local zero-config, PostgreSQL for production)
# SQLite: "file:./dev.db"
# PostgreSQL: "postgresql://username:password@localhost:5432/inzovate_hrms?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Secret for Session & Tokens (Generate a strong 256-bit random string)
JWT_SECRET="your-strong-random-jwt-secret-here"

# Company Identity
COMPANY_NAME="INZOVATE TECHNOLOGIES PRIVATE LIMITED"
COMPANY_DOMAIN="inzovate-technologies.com"
APP_TIMEZONE="Asia/Kolkata"
APP_CURRENCY="INR"

# Shift and Attendance Rules
SHIFT_START="09:30"
GRACE_END="09:45"
SHIFT_END="17:00"

# SMTP Email Service (Configure with your enterprise mail server or SendGrid/SES)
SMTP_HOST="smtp.inzovate-technologies.com"
SMTP_PORT=587
SMTP_USER="hr@inzovate-technologies.com"
SMTP_PASS="your-secure-smtp-password"
SMTP_FROM="Inzovate HRMS <hr@inzovate-technologies.com>"

# AI Voice & Automation Provider (Google Gemini / OpenAI compatible)
AI_API_KEY="your-ai-api-key"
AI_MODEL="gemini-1.5-pro"
